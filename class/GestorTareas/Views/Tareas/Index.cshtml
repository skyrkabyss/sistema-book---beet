@model IEnumerable<GestorTareas.Models.Tarea>

@{
    ViewData["Title"] = "Listado de Tareas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Tareas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva tarea</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Descripción</th>
                <th>Fecha Límite</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No hay tareas registradas.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Titulo</td>
                    <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                    <td>@(item.FechaLimite.HasValue ? item.FechaLimite.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        @if (item.Completada)
                        {
                            <span class="badge bg-success">Completada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            @if (!item.Completada)
                            {
                                <form asp-action="Completar" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">Completar</button>
                                </form>
                            }
                            <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar esta tarea?');">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
