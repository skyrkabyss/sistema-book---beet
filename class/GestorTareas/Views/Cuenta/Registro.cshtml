@model RegistroForm
@{ ViewData["Title"]="Crear cuenta"; }
<section class="account-section"><div class="shell account-layout"><div class="account-aside"><span class="eyebrow light">❧ BOOK & BEET</span><h1>Un nuevo capítulo<br/><i>te espera.</i></h1><p>Guarda tus playlists, alquila libros y crea tu propio espacio de lectura.</p><span class="aside-ornament">✧ &nbsp; ♫ &nbsp; ❧</span></div><div class="account-form"><p class="eyebrow">ÚNETE A LA COMUNIDAD</p><h2>Crear cuenta</h2><p class="muted">¿Ya tienes una cuenta? <a asp-action="Login">Inicia sesión</a>.</p><form asp-action="Registro" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger small"></div><label asp-for="Nombre">Tu nombre</label><input asp-for="Nombre" class="form-control" maxlength="80" autocomplete="name" placeholder="¿Cómo te llamas?"/><label asp-for="Apellido">Apellido</label><input asp-for="Apellido" class="form-control" maxlength="50" autocomplete="family-name" required/><label asp-for="Email">Correo electrónico</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="tu@correo.com"/><label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Mínimo 8 caracteres y un número"/><label asp-for="ConfirmarPassword">Confirma tu contraseña</label><input asp-for="ConfirmarPassword" type="password" class="form-control" autocomplete="new-password"/><button class="btn btn-earth w-100 mt-4" type="submit">Crear mi cuenta →</button></form><a class="guest-link" asp-controller="Home" asp-action="Index">Seguir explorando como invitado →</a></div></div></section>
