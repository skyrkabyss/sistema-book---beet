@model LoginForm
@{ ViewData["Title"]="Iniciar sesión"; }
<section class="account-section"><div class="shell account-layout"><div class="account-aside"><span class="eyebrow light">❧ BOOK & BEET</span><h1>Vuelve a tu<br/><i>rincón favorito.</i></h1><p>Inicia sesión para alquilar libros, escuchar música y continuar tus colecciones.</p><span class="aside-ornament">♫ &nbsp; ✧ &nbsp; ❧</span></div><div class="account-form"><p class="eyebrow">BIENVENIDO DE NUEVO</p><h2>Iniciar sesión</h2><p class="muted">¿No tienes una cuenta? <a asp-action="Registro">Regístrate gratis</a>.</p><form asp-action="Login" method="post">@Html.AntiForgeryToken()<input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="All" class="text-danger small"></div><label asp-for="Email">Correo electrónico</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="tu@correo.com"/><label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="••••••••"/><label class="d-flex gap-2 align-items-center mt-3 mb-4"><input asp-for="Recordarme" /> Recordarme</label><button class="btn btn-earth w-100" type="submit">Entrar a mi cuenta →</button></form><a class="guest-link" asp-controller="Home" asp-action="Index">Continuar como invitado →</a></div></div></section>
