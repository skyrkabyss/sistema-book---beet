@model IEnumerable<LibroRenta>
@{ViewData["Title"]="Biblioteca";var generos=ViewBag.Generos as List<string>??new();}
<section class="page-hero"><div class="shell"><p class="eyebrow">BIBLIOTECA DIGITAL</p><h1>Una historia para <i>cada otoño.</i></h1><p>Explora los libros locales y visita la biblioteca gratuita para leer clásicos de Project Gutenberg.</p><a asp-action="Gratis" class="btn btn-earth mt-3">📖 Leer clásicos gratis →</a></div></section>
<section class="shell section-pad-sm"><form method="get" class="search-bar"><input type="search" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar título o autor..."/><select name="genero" aria-label="Género"><option value="">Todos</option>@foreach(var g in generos){<option value="@g" selected="@(ViewBag.Genero==g)">@g</option>}</select><button class="btn btn-earth">Buscar →</button></form>
<div class="section-heading-row mt-5"><div><p class="eyebrow">COLECCIÓN BOOK & BEET</p><h2 class="section-title">Libros para <i>descubrir</i></h2><small>Solo las ediciones digitales autorizadas permiten alquilar y leer dentro de la web.</small></div></div>
<div class="row g-4">@foreach(var libro in Model){<div class="col-sm-6 col-lg-4 col-xl-3"><article class="book-card"><div class="book-cover cover-@((libro.Id%4)+1)"><span class="cover-mini">BOOK & BEET · COLECCIÓN</span><strong>@libro.Titulo</strong><span>@libro.Autor</span></div><div class="book-card-body"><span class="category">@libro.Genero</span><h3>@libro.Titulo</h3><p>@libro.Autor</p>
<div class="card-bottom">@if(!string.IsNullOrWhiteSpace(libro.RutaLectura)||!string.IsNullOrWhiteSpace(libro.UrlLectura)||!string.IsNullOrWhiteSpace(libro.ArchivoPdf)){<strong>@(libro.PrecioRenta==0?"Lectura gratuita":"Bs "+libro.PrecioRenta.ToString("0.00")+" / 7 días")</strong>}else{<small>Solo ficha · lectura no disponible</small>}</div>
@if(!string.IsNullOrWhiteSpace(libro.RutaLectura)||!string.IsNullOrWhiteSpace(libro.UrlLectura)||!string.IsNullOrWhiteSpace(libro.ArchivoPdf)){<a class="btn btn-earth w-100" asp-action="Detalle" asp-route-id="@libro.Id">Alquilar / leer</a>}
else{<a class="btn btn-outline-earth w-100" asp-action="Gratis">Buscar edición libre</a>}</div></article></div>}</div>
@if(!Model.Any()){<div class="empty-message">No hay libros con ese filtro. Visita los libros gratuitos.</div>}</section>
